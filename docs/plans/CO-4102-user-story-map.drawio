<mxfile host="app.diagrams.net"><diagram name="CO-4102 story map" id="co4102"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="CO-4102 - User story map: Board save states and close confirmations (Calendars)" style="text;html=1;fontSize=22;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Source: Figma 'Docs: Board save states and close confirmations' (node 2323:155). Scope here: Calendars module; Mails/Contacts/Tasks behaviours appear only where Calendars must cooperate." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c13" value="1. Track save state&#xa;Tabs show when something could be lost" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="200" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="c14" value="2. Close a single tab&#xa;X on tab / dropdown" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="422" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="c15" value="3. Close the board&#xa;X on the board" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="644" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="c16" value="4. Keep editing / Undo&#xa;Recover from a close" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="866" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="c17" value="5. Mails drafts&#xa;Cross-module, drafts feedback" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="1088" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="c18" value="6. Enablers&#xa;Copy, a11y, shell" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="1310" y="120" width="210" height="70" as="geometry"/></mxCell><mxCell id="c19" value="RELEASE 1 - MVP (CO-4102 core)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="20" y="210" width="170" height="364" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=0;fillColor=none;strokeColor=#82b366;dashed=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="194" y="204" width="1332" height="374" as="geometry"/></mxCell><mxCell id="c21" value="Editor notifies the Shell of its status: only dirty / pristine in R1. Pencil on tab icon as soon as dirty, gone when pristine (UC-01). No Saving / Saved yet" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="210" width="206" height="110" as="geometry"/></mxCell><mxCell id="c22" value="NEW SHELL API (carbonio-shell-ui): read open boards (id, module, title, order) so Calendars needs no local tracking or temporary workaround" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="328" width="206" height="110" as="geometry"/></mxCell><mxCell id="c66" value="NEW SHELL API: intercept close requests (tab X, dropdown, board X). Module can defer/veto; Shell closes only after confirmation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="446" width="206" height="110" as="geometry"/></mxCell><mxCell id="c23" value="Close tab with no changes: closes immediately, no modal (UC-07)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="422" y="210" width="206" height="110" as="geometry"/></mxCell><mxCell id="c24" value="Single-tab modal 'Close {Title}?' with Keep editing / Close and discard (UC-08). Tab stays open while the modal is shown" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="422" y="328" width="206" height="110" as="geometry"/></mxCell><mxCell id="c25" value="Keep editing, X and Esc just dismiss the modal: tab was never closed, focus on it. Real close only on confirm" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="422" y="446" width="206" height="110" as="geometry"/></mxCell><mxCell id="c26" value="Board with no dirty tab: closes, no modal (UC-11)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="644" y="210" width="206" height="110" as="geometry"/></mxCell><mxCell id="c27" value="ONE aggregated modal 'Close the board?' listing only dirty items, whatever the number of tabs (UC-12). All boards stay open while it is shown. R1: no Mails exception, no fixed note line under the list (both later)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="644" y="328" width="206" height="110" as="geometry"/></mxCell><mxCell id="c28" value="Close and discard (confirm): ONLY now the Shell closes every tab via the new Shell API, changes dropped" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="644" y="446" width="206" height="110" as="geometry"/></mxCell><mxCell id="c29" value="Keep editing: close request cancelled via Shell API, nothing to reopen. All tabs untouched, original order kept" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="866" y="210" width="206" height="110" as="geometry"/></mxCell><mxCell id="c30" value="setCurrentBoard on the first dirty tab" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="866" y="328" width="206" height="110" as="geometry"/></mxCell><mxCell id="c31" value="Dirty editors keep content, no flicker: no close/re-add cycle (open point 2 solved by design)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="866" y="446" width="206" height="110" as="geometry"/></mxCell><mxCell id="c32" value="Weblate strings for modals and buttons (EN + IT)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="210" width="206" height="110" as="geometry"/></mxCell><mxCell id="c33" value="Modal a11y: focus on Keep editing, focus trap, Esc/X = Keep editing, focus back to tab" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="328" width="206" height="110" as="geometry"/></mxCell><mxCell id="c34" value="Shell API release: publish carbonio-shell-ui version, document the API, bump Calendars minimum Shell version" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="446" width="206" height="110" as="geometry"/></mxCell><mxCell id="c35" value="RELEASE 2 - Real-time Saving/Saved states, Undo, a11y" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="20" y="604" width="170" height="600" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=0;fillColor=none;strokeColor=#6c8ebf;dashed=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="194" y="598" width="1332" height="610" as="geometry"/></mxCell><mxCell id="c37" value="Real-time status change: Unsaved / Saving... / Saved (3 s then rest) for Save action, Editor notifies the Shell on every transition (UC-02). Deferred from R1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="604" width="206" height="110" as="geometry"/></mxCell><mxCell id="c38" value="Edit while saving returns to Unsaved, never Saved (UC-04)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="722" width="206" height="110" as="geometry"/></mxCell><mxCell id="c39" value="Save only enabled in Unsaved" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="840" width="206" height="110" as="geometry"/></mxCell><mxCell id="c40" value="Tab tooltip: full title + state '{Title} · Unsaved', also on keyboard focus (UC-06)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="958" width="206" height="110" as="geometry"/></mxCell><mxCell id="c41" value="Dropdown shows pencil + 'From Calendars · {State}' as read when opened" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="1076" width="206" height="110" as="geometry"/></mxCell><mxCell id="c42" value="Info snackbar 'Changes discarded' + UNDO, 6 s progress bar (UC-09)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="422" y="604" width="206" height="110" as="geometry"/></mxCell><mxCell id="c43" value="Undo restores tab in original position, content kept, Unsaved" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="422" y="722" width="206" height="110" as="geometry"/></mxCell><mxCell id="c44" value="Browser native dialog on window close when at least one pencil is visible (UC-16)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="644" y="604" width="206" height="110" as="geometry"/></mxCell><mxCell id="c45" value="Undo after board discard reopens the whole board, selects first discarded item (UC-13 Calendars part)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="866" y="604" width="206" height="110" as="geometry"/></mxCell><mxCell id="c46" value="Snackbar timer pauses on hover and focus (a11y)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="866" y="722" width="206" height="110" as="geometry"/></mxCell><mxCell id="c47" value="Polite live-region announcement for every state change; tab accessible name '{Title}, Unsaved'" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="604" width="206" height="110" as="geometry"/></mxCell><mxCell id="c48" value="Reduced motion: progress bars not animated" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="722" width="206" height="110" as="geometry"/></mxCell><mxCell id="c49" value="Weblate strings for states and snackbars" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="840" width="206" height="110" as="geometry"/></mxCell><mxCell id="c50" value="RELEASE 3 - Mails exception (autosave), fixed note line, draft snackbars, cross-module" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="20" y="1234" width="170" height="482" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=0;fillColor=none;strokeColor=#d79b00;dashed=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="194" y="1228" width="1332" height="492" as="geometry"/></mxCell><mxCell id="c52" value="Dropdown state updates in REAL TIME (Unsaved/Saving/Saved) in sync with tab and editor" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="422" y="840" width="206" height="110" as="geometry"/></mxCell><mxCell id="c67" value="MAILS EXCEPTION: Mails autosave (30 s / 5 s) and save-on-close, so Mails items with pencil are never listed as lost and close without confirmation (UC-03, UC-10, UC-11). Needs cross-module Shell info" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="1234" width="206" height="110" as="geometry"/></mxCell><mxCell id="c53" value="Dropdown width 252 px, stays inside viewport when docked right (open point 7)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="1352" width="206" height="110" as="geometry"/></mxCell><mxCell id="c54" value="Many tabs: compact header, tabs closed from dropdown (UC-18, open point 8)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="200" y="1470" width="206" height="110" as="geometry"/></mxCell><mxCell id="c55" value="FIXED LINE under the list of unsaved boards in the aggregated modal: Mails note '{N} e-mails will be saved to Drafts: {titles}' (UC-12, UC-17). Deferred from R1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="644" y="1234" width="206" height="110" as="geometry"/></mxCell><mxCell id="c56" value="ONE modal across modules (Calendars + Contacts + Tasks), needs shell coordination (open point 1)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="644" y="1352" width="206" height="110" as="geometry"/></mxCell><mxCell id="c57" value="Single snackbar 'Changes discarded, {N} draft(s) saved' + UNDO; Mails items return without pencil (UC-13)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="866" y="1234" width="206" height="110" as="geometry"/></mxCell><mxCell id="c58" value="SNACKBAR for drafts: 'Draft saved to Drafts' / '{N} drafts saved to Drafts', 4 s (UC-10, UC-11, UC-17)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1088" y="1234" width="206" height="110" as="geometry"/></mxCell><mxCell id="c59" value="Draft save fails: modal 'Draft not saved' Keep editing / Retry / Close and discard; Retry removed after 2nd failure (UC-14, open point 3)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1088" y="1352" width="206" height="110" as="geometry"/></mxCell><mxCell id="c60" value="'Draft deleted' snackbar (+ optional Undo) (UC-15, open point 5)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1088" y="1470" width="206" height="110" as="geometry"/></mxCell><mxCell id="c61" value="Autosave behaviour with network down (open point 4)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1088" y="1588" width="206" height="110" as="geometry"/></mxCell><mxCell id="c62" value="Extend the Release 1 Shell API for cross-module board state sharing (Mails, Contacts, Tasks adopt it)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="1234" width="206" height="110" as="geometry"/></mxCell><mxCell id="c63" value="Align Mails editor strings (open point 6)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="1352" width="206" height="110" as="geometry"/></mxCell><mxCell id="c64" value="Info snackbar progress colour check vs UI kit (open point 9)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fffbe6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;arcSize=6" vertex="1" parent="1"><mxGeometry x="1310" y="1470" width="206" height="110" as="geometry"/></mxCell><mxCell id="c65" value="Scope decisions: R1 implements ONLY the dirty/pristine status (no Saving/Saved real-time changes, moved to R2). The Mails exception (autosave) and the fixed note line under the unsaved-boards list in the modal are deferred to a second or third implementation (R3 here). Order rationale: R1 uses the new Shell API only (no local temporary implementation in Calendars, so the API is built in R1) and delivers the Jira acceptance criteria: boards are NOT closed while the modal is open, Keep editing just dismisses it (focus on first dirty tab), the actual close occurs only when the user confirms, no dirty = no modal. R2 adds real-time Saving/Saved states (tab, dropdown, editor), Undo and a11y. R3 holds the Mails exception, the modal fixed line, the drafts snackbars and cross-module work." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="20" y="1746" width="1500" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>